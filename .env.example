# Copy to .env and fill in values.
# cp .env.example .env

# Postgres (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/newseason

# Supabase auth — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL (used when generating respondent links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vapi — dashboard.vapi.ai → API Keys
# Server-side key for creating web calls (/api/calls/start)
VAPI_PUBLIC_KEY=your-vapi-api-key
# Client-side public key for the browser SDK (call-screen)
NEXT_PUBLIC_VAPI_KEY=your-vapi-public-key

# Post-call findings and insights generation
OPENAI_API_KEY=sk-...

# Optional: some hosts (e.g. Vercel) expose POSTGRES_URL instead of DATABASE_URL
# POSTGRES_URL=
