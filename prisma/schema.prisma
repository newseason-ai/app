// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  completed
  abandoned
  error
}

model Company {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  logoUrl   String?    @map("logo_url")
  // TODO: multi-user — if multiple operators per company needed, replace userId with
  // a CompanyMember join table (company_id, user_id) and update dashboard query accordingly
  userId    String?    @map("user_id") @db.Uuid
  templates Template[]

  @@map("companies")
}

model Template {
  id                String      @id @default(cuid())
  companyId         String      @map("company_id")
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  context           String?
  background        String?
  directedQuestions Json        @default("[]") @map("directed_questions")
  targetDurationS   Int?        @default(120) @map("target_duration_s")
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  linkTokens        LinkToken[]
  insights          Insight[]

  @@index([companyId])
  @@map("templates")
}

model LinkToken {
  id                String    @id @default(cuid())
  templateId        String    @map("template_id")
  template          Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  token             String    @unique
  label             String?
  respondentRef     String?   @map("respondent_ref")
  respondentContext String?   @map("respondent_context")
  metadata          Json?     @default("{}")
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  sessions          Session[]

  @@index([templateId])
  @@map("link_tokens")
}

model Session {
  id                String           @id @default(cuid())
  linkTokenId       String           @map("link_token_id")
  linkToken         LinkToken        @relation(fields: [linkTokenId], references: [id], onDelete: Cascade)
  respondentRef     String?          @map("respondent_ref")
  vapiCallId        String           @map("vapi_call_id")
  status            SessionStatus
  durationS         Int?             @map("duration_s")
  audioS3Key        String?          @map("audio_s3_key")
  startedAt         DateTime         @map("started_at")
  endedAt           DateTime?        @map("ended_at")
  followUpOptIn     Boolean          @default(false) @map("follow_up_opt_in")
  sentiment         String?
  completionQuality String?          @map("completion_quality")
  transcriptTurns   TranscriptTurn[]
  findings          Finding[]

  @@index([linkTokenId])
  @@index([vapiCallId])
  @@map("sessions")
}

model TranscriptTurn {
  id         String  @id @default(cuid())
  sessionId  String  @map("session_id")
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker    String
  content    String
  turnIndex  Int     @map("turn_index")
  startedAtS Float   @map("started_at_s")

  @@index([sessionId])
  @@map("transcript_turns")
}

model Finding {
  id           String   @id @default(cuid())
  sessionId    String   @map("session_id")
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText String?  @map("question_text")
  title        String?
  synthesis    String
  evidence     String
  sentiment    String?
  turnIndex    Int?     @map("turn_index")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("findings")
}

model Insight {
  id           String   @id @default(cuid())
  templateId   String   @map("template_id")
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  generatedAt  DateTime @default(now()) @map("generated_at")
  sessionCount Int      @map("session_count")
  content      Json

  @@index([templateId])
  @@map("insights")
}