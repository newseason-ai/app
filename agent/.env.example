# LiveKit Cloud project credentials (Settings -> Keys in the dashboard)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime API
OPENAI_API_KEY=

# Where the agent POSTs streamed transcript turns. In local dev this is your
# Next.js server (e.g. http://localhost:3000). In production this is your
# deployed app origin.
TRANSCRIPT_CALLBACK_URL=http://localhost:3000/api/calls/transcript

# Shared secret used to sign POSTs to TRANSCRIPT_CALLBACK_URL. Must match the
# value configured on the Next.js side.
TRANSCRIPT_CALLBACK_SECRET=
