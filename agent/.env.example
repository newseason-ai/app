# Copy to .env and fill in values.
# cp .env.example .env

# LiveKit Cloud — Settings → Keys (same project as root .env)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# OpenAI Realtime API (voice interviews)
OPENAI_API_KEY=sk-...

# Where the agent POSTs streamed transcript turns.
# Local dev: your Next.js server. Production: your deployed app origin.
TRANSCRIPT_CALLBACK_URL=http://localhost:3000/api/calls/transcript

# Shared secret for signing transcript POSTs. Must match root .env.
TRANSCRIPT_CALLBACK_SECRET=generate-a-random-secret
